{
  "name": "@fateforge/archery-cli",
  "version": "1.0.15",
  "description": "Archery SQL audit CLI for AI Agents - manage SQL workflows, queries, instances, diagnostics, and data dictionaries with a machine-readable contract",
  "keywords": [
    "archery",
    "sql",
    "audit",
    "cli",
    "ai-agent"
  ],
  "author": "Sean Guo",
  "homepage": "https://github.com/fatecannotbealtered/archery-cli#readme",
  "bugs": {
    "url": "https://github.com/fatecannotbealtered/archery-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatecannotbealtered/archery-cli.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "archery-cli": "scripts/run.js"
  },
  "scripts": {
    "version": "node scripts/sync-version.js",
    "check-version": "node scripts/check-version.js"
  },
  "optionalDependencies": {
    "@fateforge/archery-cli-darwin-arm64": "1.0.15",
    "@fateforge/archery-cli-darwin-x64": "1.0.15",
    "@fateforge/archery-cli-linux-arm64": "1.0.15",
    "@fateforge/archery-cli-linux-x64": "1.0.15",
    "@fateforge/archery-cli-win32-arm64": "1.0.15",
    "@fateforge/archery-cli-win32-x64": "1.0.15"
  },
  "files": [
    "scripts/run.js",
    "skills/",
    "README.md",
    "README_zh.md",
    "*_zh.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "AGENTS.md",
    ".agent/",
    "docs/"
  ],
  "engines": {
    "node": ">=16"
  }
}
